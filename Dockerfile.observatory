FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/observatory ./cmd/observatory

FROM alpine:3.20

WORKDIR /app

COPY --from=builder /out/observatory /usr/local/bin/observatory
COPY --from=builder /app/scenarios ./scenarios

EXPOSE 9000

CMD ["observatory"]
